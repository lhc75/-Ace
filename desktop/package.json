{
  "name": "interview-assistant-desktop",
  "version": "2.0.3",
  "description": "面试Ace InterviewAce - Electron 桌面端",
  "appDisplayName": "面试Ace",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "npm run build:native && electron-builder --win --x64",
    "dist:mac": "npm run build:native && electron-builder --mac --arm64",
    "build:native": "node-gyp rebuild",
    "test:desktop": "node --test *.test.js"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.0.12",
    "node-gyp": "^12.4.0"
  },
  "build": {
    "appId": "com.interviewassistant.desktop",
    "productName": "面试Ace",
    "directories": {
      "output": "../release"
    },
    "asar": true,
    "files": [
      "main.js",
      "captureProtection.js",
      "preload.js",
      "shortcuts.js",
      "windowOptions.js",
      "multiScreenBatch.js",
      "backendShutdown.js",
      "updateCore.js",
      "updater.js",
      "portPicker.js",
      "startupSafety.js",
      "appLogger.js",
      "windowsInstaller.js",
      "userDataMigration.js",
      "app-title.json",
      "icon.png",
      "package.json",
      "!**/*.test.js"
    ],
    "extraResources": [
      {
        "from": "../build/backend/interview-assistant-backend",
        "to": "backend"
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "../backend/config.example.json",
        "to": "backend/config.example.json"
      },
      {
        "from": "../backend/assets",
        "to": "backend/assets"
      },
      {
        "from": "build/Release/capture_guard.node",
        "to": "capture_guard.node"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "mac": {
      "artifactName": "InterviewAce-${version}-arm64.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "icon.icns",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "用于采集面试语音并进行实时转写。",
        "NSScreenCaptureUsageDescription": "用于截取题目区域并提交给识图模型分析。"
      }
    },
    "nsis": {
      "artifactName": "InterviewAce-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "InterviewAssistant-Portable-${version}.${ext}"
    }
  }
}
